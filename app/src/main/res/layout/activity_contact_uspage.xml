<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context="com.mynexmy.nex.Activitys.ContactUspage">

    <RelativeLayout

        android:id="@+id/l1"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/white">


        <ImageView
            android:id="@+id/btnback"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:src="@drawable/baseline_keyboard_backspace_24"

            />

        <TextView
            android:id="@+id/tv_myc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_centerInParent="true"
            android:fontFamily="@font/proxima"
            android:text="Contact Us"
            android:textColor="@color/black"
            android:textSize="20dp"
            android:textStyle="bold" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_alignParentBottom="true"
            android:background="#BAB4B4">

        </RelativeLayout>

    </RelativeLayout>
 <ScrollView
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:scrollbars="none"
     >

     <LinearLayout
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:orientation="vertical"


         >

         <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:layout_marginTop="20dp"
             android:orientation="vertical">


             <RelativeLayout
                 android:layout_width="match_parent"
                 android:layout_height="40dp"
                 android:layout_marginHorizontal="20dp"
                 android:layout_marginBottom="8dp"
                 android:background="@drawable/shape_manage"
                 android:elevation="5dp">

                 <EditText
                     android:id="@+id/etConMob"
                     android:layout_width="match_parent"
                     android:layout_height="40dp"
                    android:layout_marginHorizontal="10dp"
                     android:background="@null"
                     android:fontFamily="@font/proxima"
                     android:hint="Mobile Number"
                     android:textColor="@color/black"
                     android:textSize="15dp"
                     android:textColorHint="@color/ettext"/>

             </RelativeLayout>
         </LinearLayout>

         <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:orientation="vertical">


             <RelativeLayout
                 android:layout_width="match_parent"
                 android:layout_height="40dp"
                 android:layout_marginHorizontal="20dp"
                 android:layout_marginBottom="8dp"
                 android:background="@drawable/shape_manage"
                 android:elevation="5dp"

                 >

                 <EditText
                     android:id="@+id/etConEmail"
                     android:layout_width="match_parent"
                     android:layout_height="40dp"
                     android:layout_marginHorizontal="10dp"
                     android:background="@null"
                     android:fontFamily="@font/proxima"
                     android:hint="Email"
                     android:textColor="@color/black"
                     android:textSize="15dp"
                     android:textColorHint="@color/ettext"
                     />

             </RelativeLayout>
         </LinearLayout>

         <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:orientation="vertical"

             >


             <RelativeLayout
                 android:layout_width="match_parent"
                 android:layout_height="40dp"
                 android:layout_marginHorizontal="20dp"
                 android:layout_marginBottom="8dp"
                 android:background="@drawable/shape_manage"
                 android:elevation="5dp"

                 >

                 <EditText
                     android:id="@+id/etConSubject"

                     android:layout_width="match_parent"
                     android:layout_height="40dp"
                     android:layout_marginHorizontal="10dp"
                     android:background="@null"
                     android:textColorHint="@color/ettext"
                     android:fontFamily="@font/proxima"
                     android:hint="Subject"
                     android:textColor="@color/black"
                     android:textSize="15dp" />

             </RelativeLayout>
         </LinearLayout>


         <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:orientation="vertical"

             >


             <RelativeLayout
                 android:layout_width="match_parent"
                 android:layout_height="100dp"
                 android:layout_marginHorizontal="20dp"
                 android:layout_marginBottom="8dp"
                 android:background="@drawable/shape_manage"
                 android:elevation="5dp"

                 >

                 <EditText
                     android:id="@+id/etConMessage"

                     android:layout_marginTop="@dimen/_7sdp"
                     android:layout_width="match_parent"
                     android:layout_height="wrap_content"
                     android:layout_marginHorizontal="10dp"
                     android:background="@null"
                     android:fontFamily="@font/proxima"
                     android:hint="Message"
                     android:textColor="@color/black"
                     android:textSize="15dp"
                     android:textColorHint="@color/ettext"/>

             </RelativeLayout>


         </LinearLayout>


         <RelativeLayout
             android:id="@+id/rlContact"
             android:layout_width="match_parent"
             android:layout_height="50dp"
             android:layout_marginHorizontal="100dp"
             android:layout_marginTop="@dimen/_20sdp"
             android:background="@drawable/login_button"
android:elevation="@dimen/_5sdp"
             >

             <TextView
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:layout_centerInParent="true"
                 android:text="Submit"
                 android:textColor="@color/white"
                 android:textSize="@dimen/_16sdp"
                 android:textStyle="bold" />


         </RelativeLayout>


         <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:orientation="vertical"

             >

             <RelativeLayout
                 android:layout_width="match_parent"
                 android:layout_height="22dp"
                 android:layout_marginTop="@dimen/_15sdp"


                 >

                 <LinearLayout
                     android:layout_width="match_parent"
                     android:layout_height="match_parent"
                     android:gravity="center"
                     android:orientation="horizontal"

                     >


                     <ImageView
                         android:id="@+id/imgCall"
                         android:layout_width="@dimen/_18sdp"
                         android:layout_height="@dimen/_18sdp"
                         android:gravity="center"
                         android:src="@drawable/call"

                         />

                     <TextView
                         android:layout_width="wrap_content"
                         android:layout_height="wrap_content"
                         android:layout_marginStart="@dimen/_10sdp"
                         android:text="Call to Us :"
                         android:textColor="@color/black"
                         android:textSize="18sp"
                         android:textStyle="bold"
                         android:gravity="center"
                         />


                 </LinearLayout>


             </RelativeLayout>

             <TextView
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:layout_gravity="center"
                 android:layout_marginStart="@dimen/_10sdp"
                 android:layout_marginTop="@dimen/_2sdp"
                 android:text="We’re available 24/7, 7 days a week. "
                 android:textColor="@color/black"
                 android:textSize="16sp"
                 android:gravity="center"
                 />


             <TextView
                 android:id="@+id/tvCall"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:layout_gravity="center"
                 android:layout_marginStart="@dimen/_10sdp"
                 android:layout_marginTop="@dimen/_1sdp"
                 android:text="18002035817 "
                 android:textColor="@color/main"
                 android:textSize="16sp"
                 android:textStyle="bold"
                 android:layout_marginBottom="@dimen/_5sdp"
                 android:gravity="center"
                 />


         </LinearLayout>


         <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:orientation="vertical">

             <RelativeLayout
                 android:layout_width="match_parent"
                 android:layout_height="22dp"
                 android:layout_marginTop="@dimen/_15sdp"


                 >

                 <LinearLayout
                     android:layout_width="match_parent"
                     android:layout_height="match_parent"
                     android:gravity="center"
                     android:orientation="horizontal"

                     >

                     <ImageView
                         android:layout_width="@dimen/_18sdp"
                         android:layout_height="@dimen/_18sdp"
                         android:src="@drawable/msg"
android:id="@+id/imgEmail"
                         android:gravity="center"
                         />


                     <TextView
                         android:layout_width="wrap_content"
                         android:layout_height="wrap_content"
                         android:layout_marginStart="@dimen/_10sdp"
                         android:text="Write to Us:"
                         android:textColor="@color/black"
                         android:textSize="18sp"
                         android:textStyle="bold"
                         android:gravity="center"
                         />


                 </LinearLayout>


             </RelativeLayout>

             <TextView
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:layout_gravity="center"
                 android:layout_marginTop="@dimen/_2sdp"
                 android:text="Fill out our form and we will\ncontact you within 24 hours."
                 android:textColor="@color/black"
                 android:textSize="16sp"
                 android:layout_marginStart="@dimen/_10sdp"
android:gravity="center"
                 />


             <TextView
                 android:id="@+id/tvEmail"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:layout_gravity="center"
                 android:layout_marginStart="@dimen/_10sdp"
                 android:layout_marginTop="@dimen/_1sdp"
                 android:text="Email: info@3nex.co.in"
                 android:textColor="@color/main"
                 android:textSize="16sp"
                 android:textStyle="bold"
                 android:gravity="center"
                 />


         </LinearLayout>

         <LinearLayout
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:orientation="vertical">

             <RelativeLayout
                 android:layout_width="match_parent"
                 android:layout_height="22dp"
                 android:layout_marginTop="@dimen/_15sdp"


                 >

                 <LinearLayout
                     android:layout_width="match_parent"
                     android:layout_height="match_parent"
                     android:gravity="center"
                     android:orientation="horizontal"

                     >

                     <ImageView
                         android:layout_width="@dimen/_18sdp"
                         android:layout_height="@dimen/_18sdp"
                         android:src="@drawable/location1"
                         android:gravity="center"

                         />


                     <TextView
                         android:layout_width="wrap_content"
                         android:layout_height="wrap_content"
                         android:layout_marginStart="@dimen/_10sdp"
                         android:text="Headquarter:"
                         android:textColor="@color/black"
                         android:textSize="18sp"
                         android:textStyle="bold"
                         android:gravity="center"
                         />


                 </LinearLayout>


             </RelativeLayout>

             <TextView
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:layout_gravity="center"
                 android:layout_marginStart="@dimen/_10sdp"
                 android:layout_marginTop="@dimen/_2sdp"
                 android:text="Monday – Friday: 9:00-20:00\n
  Saturady: 11:00 – 15:00"
                 android:textColor="@color/black"
                 android:textSize="16sp"
                 android:gravity="center"

                 />


             <TextView
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:layout_gravity="center"
                 android:layout_marginHorizontal="@dimen/_15sdp"
                 android:layout_marginTop="@dimen/_1sdp"
                 android:text="#883 Banksia 101, 10th Cross Rd, 7th Stage\nBEML Layout, Mailsandra, R R Nagar, Bangalore, Karnataka – 560098"
                 android:textColor="@color/main"
                 android:textSize="16sp"
                 android:textStyle="bold"
                 android:gravity="center"
                 />


         </LinearLayout>

     </LinearLayout>
 </ScrollView>



</LinearLayout>