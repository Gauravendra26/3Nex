<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="@dimen/_10sdp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        >


        <androidx.cardview.widget.CardView
            android:id="@+id/imgAlertLogo"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_gravity="center"
            android:layout_marginLeft="@dimen/_5sdp"
            android:layout_centerVertical="true"
           android:layout_marginVertical="@dimen/_5sdp"
            app:cardCornerRadius="@dimen/_10sdp"
            app:cardElevation="@dimen/_4sdp">

            <ImageView
                android:id="@+id/imgP"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:layout_gravity="center"
                android:scaleType="fitXY"
                android:src="@drawable/profile" />


        </androidx.cardview.widget.CardView>
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3NEX"
            android:textSize="@dimen/_20sdp"
            android:layout_marginLeft="@dimen/_10sdp"
            android:textStyle="bold"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@+id/imgAlertLogo"
            android:fontFamily="@font/proxima"
            android:textColor="#bf1922"
            />

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >
        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:text="*"


            android:textColor="@color/black"
            android:layout_marginLeft="@dimen/_6sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginBottom="10dp"/>
        <TextView

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Click stalls Delivery only if your purchasing scratch at our stall."
            android:textSize="15dp"
            android:textColor="@color/black"
            android:layout_marginLeft="@dimen/_6sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginBottom="10dp"/>


    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >
        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:text="*"

            android:layout_marginLeft="@dimen/_6sdp"
            android:layout_marginTop="@dimen/_2sdp"
            android:layout_marginBottom="10dp"/>
        <TextView

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Click online for online scratch card."
            android:textSize="15dp"
            android:textColor="@color/black"
            android:layout_marginLeft="@dimen/_6sdp"

            android:layout_marginBottom="10dp"/>


    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >
        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="17dp"
            android:text="@string/Note"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginLeft="@dimen/_6sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginBottom="@dimen/_5sdp"/>


    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >
        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15dp"
            android:text="1."
            android:textColor="@color/black"

            android:layout_marginLeft="@dimen/_6sdp"
            android:layout_marginTop="@dimen/_1sdp"
            android:layout_marginBottom="10dp"/>
        <TextView

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Our stalls are at selected location for limited period only."
            android:textSize="15dp"
            android:textColor="@color/black"
            android:layout_marginLeft="@dimen/_6sdp"

            android:layout_marginBottom="10dp"/>


    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >
        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15dp"
            android:text="2."
            android:textColor="@color/black"

            android:layout_marginLeft="@dimen/_6sdp"
            android:layout_marginTop="@dimen/_1sdp"
            android:layout_marginBottom="16dp"/>
        <TextView

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:text="If You Purchase in the online It will delivery in your door step
at 3 to 5 business working days."
            android:textSize="15dp"
            android:layout_marginLeft="@dimen/_6sdp"

            android:layout_marginBottom="16dp"/>


    </LinearLayout>

    <LinearLayout
        android:id="@+id/llLinkshareDone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"


        android:orientation="horizontal"
        android:weightSum="2">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"


            >
            <ImageView
                android:layout_width="@dimen/_80sdp"
                android:layout_height="@dimen/_80sdp"
                android:src="@drawable/stall"
                android:scaleType="fitXY"
                android:layout_gravity="right"
                android:layout_marginRight="@dimen/_15sdp"
                />


            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/_80sdp"
                android:layout_height="40dp"
                app:cardCornerRadius="@dimen/_10sdp"
                app:cardElevation="3dp"
                android:id="@+id/mcvStallScratch"
                android:clickable="true"
                android:layout_marginBottom="@dimen/_30sdp"
                android:layout_gravity="right"
                android:layout_marginRight="@dimen/_15sdp"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:rippleColor="@color/white">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:background="@color/darkyellow"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stall"

                    android:layout_gravity="center"
                    android:fontFamily="@font/proxima"

                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    />
            </com.google.android.material.card.MaterialCardView>



        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"


            >
            <ImageView
                android:layout_width="@dimen/_80sdp"
                android:layout_height="@dimen/_80sdp"
                android:src="@drawable/online"
                android:scaleType="fitXY"
                android:padding="@dimen/_4sdp"
                android:layout_gravity="left"
                android:layout_marginLeft="@dimen/_15sdp"
                />


            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/_80sdp"
                android:layout_height="40dp"
                app:cardCornerRadius="@dimen/_10sdp"
                app:cardElevation="3dp"
                android:id="@+id/mcvOnlineScratch"
                android:clickable="true"
                android:layout_marginBottom="@dimen/_30sdp"
                android:layout_gravity="left"
                android:layout_marginLeft="@dimen/_15sdp"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:rippleColor="@color/white">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:background="@color/darkyellow"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Online"

                    android:layout_gravity="center"
                    android:fontFamily="@font/proxima"

                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    />
            </com.google.android.material.card.MaterialCardView>



        </LinearLayout>



    </LinearLayout>

</LinearLayout>
