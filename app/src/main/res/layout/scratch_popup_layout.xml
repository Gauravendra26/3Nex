<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">


        <androidx.cardview.widget.CardView
            android:id="@+id/card_scratch"
            android:layout_width="200dp"
            android:layout_height="200dp"
         android:layout_gravity="center"

            app:cardElevation="@dimen/_5sdp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                 android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgScratch"
                    android:layout_width="match_parent"
                    android:layout_height="155dp"
                    android:scaleType="fitXY"
                     />

                <TextView
                    android:id="@+id/tvScratch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/proxima"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_marginTop="5dp"
                    android:maxLines="2"
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    android:text="you have won\n₹1000"
                    android:textSize="15dp"
                    android:textStyle="bold" />

            </LinearLayout>


            <com.anupkumarpanwar.scratchview.ScratchView
                android:id="@+id/scratchview"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:elevation="8dp"
                android:scaleX="1.2 "
                android:scaleY="1.3 "
                app:overlay_height="200dp"
                app:overlay_image="@drawable/download_removebg"
                app:overlay_width="200dp"

                />

        </androidx.cardview.widget.CardView>



</androidx.cardview.widget.CardView>