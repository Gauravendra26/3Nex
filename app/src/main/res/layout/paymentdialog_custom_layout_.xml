<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="@dimen/_10sdp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >

        <androidx.cardview.widget.CardView
            android:id="@+id/imgAlertLogo"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_gravity="center"
            android:layout_marginLeft="@dimen/_5sdp"
            android:layout_centerVertical="true"
            android:layout_marginVertical="@dimen/_5sdp"
            app:cardCornerRadius="@dimen/_10sdp"
            app:cardElevation="@dimen/_4sdp">

            <ImageView
                android:id="@+id/imgP"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:layout_gravity="center"
                android:scaleType="fitXY"
                android:src="@drawable/profile" />


        </androidx.cardview.widget.CardView>
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3NEX"
            android:textSize="@dimen/_20sdp"
            android:layout_marginLeft="@dimen/_10sdp"
            android:textStyle="bold"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@+id/imgAlertLogo"
            android:fontFamily="@font/proxima"
            android:textColor="#bf1922"
            />

    </RelativeLayout>

    <TextView
         android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Payment Failed"
 android:gravity="center"
        android:textSize="@dimen/_18sdp"
        android:textColor="#bf1922"
        android:textStyle="bold"
        android:fontFamily="@font/proxima"
        android:layout_marginLeft="@dimen/_6sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginBottom="@dimen/_5sdp"/>
    <TextView
        android:id="@+id/tv_merchantTxnId"
         android:layout_width="match_parent"
        android:layout_height="wrap_content"
  android:gravity="center"
        android:textSize="@dimen/_12sdp"
        android:fontFamily="@font/proxima"
        android:textColor="@color/black"
        android:layout_marginLeft="@dimen/_6sdp"
        android:layout_marginTop="@dimen/_7sdp"
        android:layout_marginBottom="@dimen/_5sdp"/>
    <TextView
        android:id="@+id/tv_atomTxnId"
         android:layout_width="match_parent"
        android:layout_height="wrap_content"
  android:gravity="center"
        android:textSize="@dimen/_12sdp"
        android:fontFamily="@font/proxima"
        android:textColor="@color/black"
        android:layout_marginLeft="@dimen/_6sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginBottom="@dimen/_5sdp"/>
    <TextView
        android:id="@+id/dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Please take Screenshot of it."
 android:gravity="center"
        android:textSize="@dimen/_15sdp"
        android:fontFamily="@font/proxima"
        android:textColor="#bf1922"
        android:layout_marginLeft="@dimen/_6sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginBottom="16dp"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginLeft="@dimen/_5sdp"
        >



        <RelativeLayout
            android:id="@+id/rlCancel"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_marginVertical="@dimen/_5sdp"
            android:background="@drawable/shape_cancel"
            android:layout_centerHorizontal="true"
             android:elevation="@dimen/_3sdp"

            android:layout_marginRight="@dimen/_10sdp"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="OK"
                android:fontFamily="@font/proxima"
                android:textColor="@color/white"
                android:textSize="@dimen/_12sdp"
                android:textStyle="bold" />

        </RelativeLayout>


    </RelativeLayout>
</LinearLayout>
