<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
 android:background="@color/white"
    android:orientation="vertical"
    tools:context="com.mynexmy.nex.Activitys.Scratch_Activity">


    <RelativeLayout
        android:id="@+id/l1"

        android:layout_width="match_parent"
        android:layout_height="40dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_alignParentLeft="true"

            android:layout_centerInParent="true"
            android:layout_marginStart="10dp"
            android:layout_marginLeft="11dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/baseline_keyboard_backspace_24" />

        <TextView
            android:id="@+id/tv_myc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/proxima"
            android:text="My Scratch Card"
            android:textColor="@color/black"
            android:textSize="20dp"
            android:textStyle="bold" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_alignParentBottom="true"
            android:background="#BAB4B4"
             >

        </RelativeLayout>

    </RelativeLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refreshLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/l1"
        >



    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"

        >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"

        >

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvScratchCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_5sdp"
                android:layout_marginVertical="@dimen/_5sdp"
                android:isScrollContainer="false"
                android:nestedScrollingEnabled="false"
                app:fastScrollEnabled="false"

                >

            </androidx.recyclerview.widget.RecyclerView>


        <TextView
            android:id="@+id/tvshow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/proxima"
            android:text="Click one of the above card to see the Gift"
            android:textColor="@color/black"
            android:textSize="@dimen/_15sdp"
            android:visibility="gone"
            android:layout_marginBottom="@dimen/_5sdp"
            />


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_25sdp"
android:id="@+id/rlScratchText"
            android:visibility="gone"
            android:background="@color/main"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/_10sdp"
                android:text="My Rewards"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textSize="@dimen/_15sdp" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rlLower"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_25sdp"
            android:background="@color/main"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/_10sdp"
                android:text="Not Scratched Coupon"
                android:textColor="@color/white"
                android:textSize="@dimen/_15sdp" />
        </RelativeLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvScratched"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/_5sdp"
            android:layout_marginVertical="@dimen/_5sdp"
            android:isScrollContainer="false"
            android:nestedScrollingEnabled="false"
            app:fastScrollEnabled="false">

        </androidx.recyclerview.widget.RecyclerView>


    </LinearLayout>


</androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <TextView
        android:id="@+id/tvScratchText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Scratch Card is Empty\nPlease Purchase"
        android:gravity="center"
        android:fontFamily="@font/merriweather_regular"
        android:layout_centerInParent="true"
        android:textSize="@dimen/_20sdp"
        android:textStyle="bold"
        android:visibility="gone"
        />


</RelativeLayout>