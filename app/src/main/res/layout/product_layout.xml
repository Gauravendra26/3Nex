<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/ll1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="horizontal"
        >

        <RelativeLayout
            android:layout_width="110dp"
            android:layout_height="95dp"
            android:layout_marginHorizontal="10dp"
            android:layout_marginVertical="10dp"

            android:background="@drawable/shape_productimg"
            android:elevation="6dp"


            >

            <ImageView
                android:id="@+id/p_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:scaleType="fitXY"
               />


        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="95dp"
            android:layout_marginVertical="10dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/shape_productimg1"
            android:elevation="6dp"

            >

            <TextView
                android:id="@+id/p_name"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_26sdp"
                android:layout_marginStart="10dp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="80dp"
                android:fontFamily="@font/proxima"
                android:text="Original Beats Solo prots solo pro"
                android:textColor="@color/black"
                android:textSize="@dimen/_13sdp"
android:maxLines="2"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/cross"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_alignParentRight="true"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/btn_cross1"


                />

            <TextView
                android:id="@+id/p_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/p_name"
                android:layout_marginStart="10dp"
                android:layout_marginTop="@dimen/_5sdp"
                android:fontFamily="@font/proxima"
                android:text="View details"
                android:textColor="@color/main"
                android:textSize="12sp"
                android:textStyle="bold"

                />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/p_description"
                android:layout_marginLeft="10dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/p_saleprice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="2dp"
                    android:fontFamily="@font/proxima"
                    android:text="600"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/p_actualprice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="20dp"


                    android:fontFamily="@font/proxima"
                    android:text="1999.99"
                    android:textSize="13sp"

                    android:textStyle="bold"

                    />


                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"


                    >

                    <ImageView
                        android:id="@+id/add"
                        android:layout_width="@dimen/_16sdp"
                        android:layout_height="@dimen/_16sdp"

                        android:layout_alignParentRight="true"
                        android:layout_alignParentBottom="true"
                        android:layout_centerVertical="true"
android:padding="@dimen/_2sdp"
                        android:src="@drawable/add" />

                    <TextView
                        android:id="@+id/p_quantity"
                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginTop="11dp"
                        android:layout_marginEnd="10dp"
                        android:layout_toLeftOf="@id/add"
                        android:fontFamily="@font/proxima"
                        android:text="1"
                        android:textColor="@color/black"
                        android:textSize="17sp"
                        android:textStyle="bold"


                        />

                    <ImageView
                        android:id="@+id/minus"
                        android:layout_width="@dimen/_16sdp"
                        android:layout_height="@dimen/_16sdp"
                        android:layout_alignParentBottom="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="10dp"
                        android:layout_toLeftOf="@id/p_quantity"
                        android:src="@drawable/minus"
                        android:padding="@dimen/_2sdp"/>

                </RelativeLayout>


            </LinearLayout>

        </RelativeLayout>


    </LinearLayout>

</LinearLayout>


