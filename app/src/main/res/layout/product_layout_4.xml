<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#fafafa">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout

            android:id="@+id/ll1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"

            android:orientation="horizontal"


            >

            <RelativeLayout
                android:layout_width="120dp"
                android:layout_height="95dp"
                android:layout_marginHorizontal="10dp"
                android:layout_marginVertical="10dp"

                android:background="@drawable/shape_productimg"
                android:elevation="8dp"


                >

                <ImageView
                    android:id="@+id/p_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="10dp"
                   />


            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="95dp"
                android:layout_marginVertical="10dp"
                android:layout_marginRight="10dp"
                android:background="@drawable/shape_productimg1"
                android:elevation="8dp"

                >

                <TextView
                    android:id="@+id/p_name"
                    android:layout_width="wrap_content"
                    android:layout_height="30sp"
                    android:layout_marginStart="10dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="80dp"
                    android:fontFamily="@font/proxima"
                    android:text="Original Beats Solo prots solo pro"
                    android:textColor="@color/black"
                    android:textSize="14sp"

                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/p_description"
                    android:layout_width="wrap_content"
                    android:layout_height="36sp"
                    android:layout_below="@id/p_name"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="5dp"
                   android:layout_marginEnd="@dimen/_5sdp"
                    android:fontFamily="@font/proxima"
                    android:text="View details"
                    android:textColor="@color/main"
                    android:textSize="12sp"
                    android:textStyle="bold" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/p_description"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="5dp"
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/p_saleprice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="2dp"
                        android:fontFamily="@font/proxima"
                        android:text="₹200"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />


                </LinearLayout>

            </RelativeLayout>


        </LinearLayout>

    </LinearLayout>


</RelativeLayout>
