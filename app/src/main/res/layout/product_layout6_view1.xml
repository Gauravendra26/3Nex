<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout

        android:layout_width="wrap_content"

        android:layout_height="wrap_content"
        android:layout_marginRight="2dp"
        android:orientation="horizontal">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            >


            <LinearLayout
                android:id="@+id/pd1"
                android:layout_width="@dimen/_140sdp"
                android:layout_height="@dimen/_180sdp"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginVertical="@dimen/_8sdp"

                android:background="@drawable/shape_pdetail"
                android:elevation="5dp"
                android:orientation="horizontal"

                >


                <LinearLayout
                    android:id="@+id/pd_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">


                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_1sdp"
                        app:cardCornerRadius="10dp"
                        >

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            >

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <ImageView
android:scaleType="fitXY"
                                    android:id="@+id/p_image"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/_111sdp"

                                   />



                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="@dimen/_20sdp"
                                    android:layout_marginStart="10dp"
                                    android:layout_marginTop="@dimen/_5sdp"
                                    android:orientation="horizontal">

                                    <ImageView

                                        android:layout_width="@dimen/_13sdp"
                                        android:layout_height="@dimen/_13sdp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/vector_star" />

                                    <TextView
                                        android:id="@+id/rating"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginLeft="1dp"
                                        android:fontFamily="@font/proxima"
                                        android:layout_gravity="center"
                                        android:text="4.9"
                                        android:textColor="@color/main"
                                        android:textSize="@dimen/_12sdp"
                                        android:textStyle="bold"
                                        android:layout_marginTop="@dimen/_1sdp"/>


                                </LinearLayout>




                            </RelativeLayout>

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="0.5dp"
                                android:background="@color/border"
                                android:elevation="@dimen/_4sdp"
                                android:layout_marginBottom="@dimen/_1sdp"
                                >

                            </RelativeLayout>


                            <TextView

                                android:id="@+id/proname"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_14sdp"
                                android:maxLines="1"
                                android:layout_marginHorizontal="10dp"
                                android:layout_marginTop="@dimen/_3sdp"
                                android:layout_centerVertical="true"
                                android:fontFamily="@font/proxima"

                                android:text="Original Beats Solo pro"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvdiscount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_2sdp"
                                android:fontFamily="@font/proxima"
                                android:text="10% off"
                                android:layout_marginStart="10dp"
                                android:textColor="@color/main"
                                android:textStyle="bold"
                                android:textSize="@dimen/_12sdp" />

                            <RelativeLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentLeft="true"
                                android:layout_marginStart="10dp"
                                android:layout_marginTop="2dp"
                                android:gravity="bottom">

                                <TextView
                                    android:id="@+id/saleprize"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/proxima"
                                    android:text="\u20B9900"
                                    android:textColor="@color/buy_now"
                                    android:textSize="@dimen/_12sdp"
                                    android:layout_marginTop="@dimen/_4sdp"
                                    />


                                <TextView
                                    android:id="@+id/actualprice"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:layout_toEndOf="@id/saleprize"
                                    android:fontFamily="@font/proxima"
                                    android:text="@string/p2"
                                    android:textColor="@color/buy_now"
                                    android:textSize="@dimen/_12sdp"
                                    android:layout_marginTop="@dimen/_4sdp"
                                    />

                                <ImageView
                                    android:id="@+id/add"
                                    android:layout_width="@dimen/_30sdp"
                                    android:layout_height="@dimen/_30sdp"
                                    android:layout_alignParentRight="true"
                                    android:layout_marginRight="@dimen/_3sdp"
                                    android:src="@drawable/vector_add"
                                    android:layout_marginBottom="@dimen/_2sdp"

                                    />


                            </RelativeLayout>

                        </LinearLayout>


                    </androidx.cardview.widget.CardView>





                </LinearLayout>


            </LinearLayout>


        </RelativeLayout>


    </LinearLayout>


</RelativeLayout>