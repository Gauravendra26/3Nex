<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context="com.mynexmy.nex.Activitys.Congratulation_Scratch_Activity2">

    <RelativeLayout
        android:id="@+id/l1"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/white">


        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
android:visibility="gone"
            android:layout_centerInParent="true"
            android:layout_marginStart="10dp"
            android:layout_marginLeft="11dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/baseline_keyboard_backspace_24" />

        <ImageView
            android:id="@+id/imgHomeLogo"
            android:layout_width="150dp"
            android:layout_height="36dp"
            android:layout_centerInParent="true"
            android:layout_marginVertical="1dp"
            android:elevation="@dimen/_5sdp"
            android:src="@drawable/nex" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_alignParentBottom="true"
            android:background="#BAB4B4">

        </RelativeLayout>

    </RelativeLayout>


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginVertical="@dimen/_15sdp"
            android:fontFamily="@font/proxima"
            android:gravity="center"
            android:text="Thanks For Making Payment To 3Nex"
            android:textColor="@color/darkRed"
            android:textSize="@dimen/_18sdp"
            android:textStyle="bold"

            />

        <ImageView
            android:layout_width="@dimen/_100sdp"
            android:layout_height="@dimen/_100sdp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="100dp"

            android:src="@drawable/check" />


    </RelativeLayout>


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="30dp"
        android:fontFamily="@font/merriweather_regular"
        android:text="Thank You\nPayment Successful"
        android:textColor="@color/black"
        android:gravity="center"
        android:textSize="@dimen/_18sdp"
        android:textStyle="bold" />

    <RelativeLayout
        android:id="@+id/rlwish"
        android:layout_width="@dimen/_120sdp"
        android:layout_height="@dimen/_35sdp"
        android:layout_gravity="center"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:background="@drawable/shape_scrcard"
android:elevation="@dimen/_5sdp"
        >

        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginLeft="@dimen/_5sdp"
            android:fontFamily="@font/proxima"
            android:text="GET CARD"
            android:textColor="@color/black"
            android:textSize="@dimen/_15sdp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="30dp"
android:visibility="gone"
            android:layout_height="30dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginRight="5dp"
            android:src="@drawable/baseline_arrow_circle_right_24" />

    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/_20sdp"
        android:gravity="center"
        android:layout_marginHorizontal="@dimen/_20sdp"
        android:fontFamily="@font/proxima"
 android:text="Special gift for users"
         android:textColor="@color/darkRed"
        android:textSize="@dimen/_18sdp"
        android:textStyle="bold"
         />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="@dimen/_30sdp"
        android:layout_marginTop="@dimen/_25sdp"
        android:fontFamily="@font/merriweather_regular"
        android:gravity="center"
        android:text="Get one free scratch card after buying 5 scratch cards."
        android:textColor="@color/black"
        android:textSize="@dimen/_15sdp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="@dimen/_30sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:fontFamily="@font/merriweather_regular"
        android:gravity="center"
        android:text="On every referral login, you will receive 20 points."
        android:textColor="@color/black"
        android:textSize="@dimen/_15sdp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="@dimen/_30sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:fontFamily="@font/merriweather_regular"
        android:gravity="center"
        android:text="As you reach 100 points or 5 scratch cards, you will receive a scratch card absolutely free of cost."
        android:textColor="@color/black"
        android:textSize="@dimen/_15sdp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvclose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/proxima"
        android:text="Close"
        android:visibility="gone"
        android:textColor="@color/logouttext"
        android:textSize="@dimen/_15sdp"
        android:textStyle="bold" />
</LinearLayout>