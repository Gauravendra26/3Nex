<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".MycartFragment">

    <RelativeLayout
        android:id="@+id/l1"
        android:layout_width="match_parent"
        android:layout_height="40dp">


        <ImageView
            android:id="@+id/btnback"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:src="@drawable/baseline_keyboard_backspace_24"


            />

        <TextView
            android:id="@+id/tv_myc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"

            android:fontFamily="@font/proxima"
            android:text="Select Address"
            android:textColor="@color/black"
            android:textSize="20dp"
            android:textStyle="bold" />


    </RelativeLayout>


    <RelativeLayout
        android:id="@+id/changeorder"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_below="@id/l1"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/shape_changeaddress">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:text="Add New Adress"
            android:textColor="@color/buy_now"
            android:textSize="18sp"
            android:textStyle="bold" />


    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:orientation="vertical"


        >

        <RelativeLayout
            android:id="@+id/defautaddress"
            android:layout_width="match_parent"


            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/shape_defaultaddress">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="5dp"
                android:text="Default Address"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"

                />


        </RelativeLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="25dp"
            android:orientation="vertical">


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"


                >

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"


                    >
                    <ImageView
                        android:id="@+id/img1"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                       android:layout_marginTop="13dp"

                        android:src="@drawable/circle_shape" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="10dp"


                        android:layout_toEndOf="@+id/img1"
                        android:text="Guest User"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <RelativeLayout
                        android:layout_width="40dp"
                        android:layout_height="15dp"
                        android:layout_alignParentRight="true"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/shape_homesummarypage">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:layout_centerVertical="true"
                            android:text="Home"
                            android:textColor="@color/main"
                            android:textSize="10sp"


                            />


                    </RelativeLayout>

                </RelativeLayout>


            </RelativeLayout>

            <TextView
                android:id="@+id/anyhouseno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="37/338B Jageshwar Nagar"
                android:textSize="14sp" />

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"


                >

                <TextView
                    android:id="@+id/anylocalarea"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dayal bagh,"
                    android:textSize="14sp"

                    />


                <TextView
                    android:id="@+id/anycity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_toEndOf="@id/anylocalarea"
                    android:text="Agra"
                    android:textColor="@color/black"

                    android:textSize="14sp" />


            </RelativeLayout>


            <TextView
                android:id="@+id/anystate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Uttar Pradesh"
                android:textSize="14sp"

                />

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"


                >

                <TextView
                    android:id="@+id/anymobile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mobile:"
                    android:textSize="14sp"

                    />


                <TextView
                    android:id="@+id/mobleno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_toEndOf="@id/anymobile"
                    android:text="8958985587"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />


            </RelativeLayout>

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="30dp"


                >

                <RelativeLayout
                    android:id="@+id/tvremove"
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/shape_changeaddress"


                    >

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"
                        android:text="REMOVE"
                        android:textColor="@color/buy_now"
                        android:textSize="16dp"
                        android:textStyle="bold"

                        />

                </RelativeLayout>


                <RelativeLayout
                    android:id="@+id/tv_tvedit"
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_toEndOf="@id/tvremove"
                    android:background="@drawable/shape_changeaddress">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"
                        android:text="EDIT"
                        android:textColor="@color/buy_now"
                        android:textSize="16dp"
                        android:textStyle="bold"

                        />

                </RelativeLayout>


            </RelativeLayout>


        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            >

            <RelativeLayout
                android:id="@+id/otheraddress"
                android:layout_width="match_parent"


                android:layout_height="55dp"

                android:background="@drawable/shape_defaultaddress">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="10dp"
                    android:layout_marginBottom="5dp"
                    android:text="Other Address"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold"

                    />


            </RelativeLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="25dp"
            android:orientation="vertical">





            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"


                >

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"


                    >
                    <ImageView
                        android:id="@+id/img2"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginTop="13dp"

                        android:src="@drawable/circle_shape" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="10dp"


                        android:layout_toEndOf="@+id/img2"
                        android:text="Guest User Two"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <RelativeLayout
                        android:layout_width="40dp"
                        android:layout_height="15dp"
                        android:layout_alignParentRight="true"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/shape_homesummarypage">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:layout_centerVertical="true"
                            android:text="Office"
                            android:textColor="@color/main"
                            android:textSize="10sp"


                            />


                    </RelativeLayout>

                </RelativeLayout>


            </RelativeLayout>

            <TextView
                android:id="@+id/anyhouseno2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="37/338B Jageshwar Nagar"
                android:textSize="14sp" />

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"


                >

                <TextView
                    android:id="@+id/anylocalarea2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dayal bagh,"
                    android:textSize="14sp"

                    />


                <TextView
                    android:id="@+id/anycity2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_toEndOf="@id/anylocalarea2"
                    android:text="Agra"
                    android:textColor="@color/black"

                    android:textSize="14sp" />


            </RelativeLayout>


            <TextView
                android:id="@+id/anystate2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Uttar Pradesh"
                android:textSize="14sp"

                />

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"


                >

                <TextView
                    android:id="@+id/anymobile2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mobile:"
                    android:textSize="14sp"

                    />


                <TextView
                    android:id="@+id/mobleno2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_toEndOf="@id/anymobile2"
                    android:text="9675754585"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />


            </RelativeLayout>




        </LinearLayout>



    </LinearLayout>


    <RelativeLayout
        android:id="@+id/rlConfirm"
        android:layout_width="match_parent"
        android:layout_height="40dp"

        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="10dp"
        android:background="@drawable/shape_buynow"
        android:layout_marginBottom="5dp"
        >


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:text="Confirm"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"


            />

    </RelativeLayout>


</RelativeLayout>